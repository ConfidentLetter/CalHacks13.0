{
  "manifest_version": 3,
  "name": "BenchMate Study Mode",
  "version": "0.1.0",
  "description": "While Study mode is on, tells your local BenchMate (localhost only) which datasheet pages you read.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["http://localhost:8000/*", "http://127.0.0.1:8000/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "action": { "default_popup": "popup.html", "default_title": "BenchMate Study Mode" },
  "options_ui": { "page": "options.html", "open_in_tab": false }
}
