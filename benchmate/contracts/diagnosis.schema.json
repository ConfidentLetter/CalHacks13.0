{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Diagnosis — what BenchMate tells the user",
  "type": "object",
  "required": ["frame_id", "mode", "findings", "needs_user_confirmation"],
  "properties": {
    "frame_id": {"type": "string"},
    "mode": {"type": "string", "enum": ["proactive", "answer"]},
    "question": {"type": ["string", "null"]},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "title", "explanation", "fix", "evidence", "confidence"],
        "properties": {
          "id": {"type": "string"},
          "severity": {"type": "string", "enum": ["error", "warning", "info", "ok"]},
          "title": {"type": "string", "description": "one line, e.g. 'SDA and SCL are swapped'"},
          "explanation": {"type": "string"},
          "fix": {"type": "string", "description": "one concrete action, e.g. 'Move the yellow wire from J22 to J21'"},
          "evidence": {
            "type": "object",
            "properties": {
              "wires": {"type": "array", "items": {"type": "string"}},
              "components": {"type": "array", "items": {"type": "string"}},
              "serial_lines": {"type": "array", "items": {"type": "string"}},
              "datasheet": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["part_id", "page"],
                  "properties": {"part_id": {"type": "string"}, "page": {"type": ["integer", "string"], "description": "PDF viewer page label as T4 search() returns it (string, e.g. \"22\"); integers accepted for legacy mocks"}, "quote": {"type": "string", "maxLength": 200}}
                }
              }
            }
          },
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "needs_user_confirmation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["element_id", "prompt"],
        "properties": {"element_id": {"type": "string"}, "prompt": {"type": "string"}}
      }
    },
    "latency_ms": {"type": "object", "additionalProperties": {"type": "number"}}
  }
}
