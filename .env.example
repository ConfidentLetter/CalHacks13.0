# Copy to .env and enter your key locally. Never commit the populated .env.
# The launcher also accepts the existing anthropic_key variable in ../.env.
ANTHROPIC_API_KEY=

# Optional: a model enabled for your account. Blank uses the bridge's default.
# CLAUDE_MODEL=

# Optional: an internal, writable runtime directory. Keep it off the MS-DOS drive.
# STUDBUD_DATA_DIR=/absolute/path/to/StudBud
